*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.myvenv/
.venv/
venv/


# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints/


# IDE
.vscode/
.idea/
*.swp


